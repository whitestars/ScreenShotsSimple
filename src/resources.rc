#include "resource.h"
#include <winres.h>

IDI_APP_ICON ICON "app.ico"

IDD_SETTINGS DIALOGEX 0, 0, 232, 118
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "ScreenShotApp"
FONT 9, "Microsoft YaHei"
BEGIN
    CONTROL "Hotkey", IDC_HOTKEY_GROUP, "Button", BS_GROUPBOX, 8, 6, 216, 48
    CONTROL "CtrlAltA", IDC_HOTKEY_CTRLALT, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 18, 22, 96, 12
    CONTROL "ShiftAltA", IDC_HOTKEY_SHIFTALT, "Button", BS_AUTORADIOBUTTON, 120, 22, 96, 12
    CONTROL "AutoStart", IDC_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 62, 120, 12
    CONTROL "", IDC_STATUS, "Static", SS_LEFT, 12, 80, 208, 10
    CONTROL "Save", IDOK, "Button", BS_PUSHBUTTON | WS_TABSTOP, 100, 96, 60, 18
    CONTROL "Hide", IDC_HIDE, "Button", BS_PUSHBUTTON | WS_TABSTOP, 164, 96, 60, 18
END
